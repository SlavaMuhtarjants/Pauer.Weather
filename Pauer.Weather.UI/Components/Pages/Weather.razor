@page "/"

@using System.Threading
@using MediatR
@using Pauer.Weather.Application.Cities
@using Pauer.Weather.Application.Cities.Dto
@using Pauer.Weather.Application.Countries
@using Pauer.Weather.Application.Countries.Dto
@using Pauer.Weather.Application.GetWeather
@using Pauer.Weather.Application.GetWeather.Dto

@inject ISender Sender

@rendermode @(new InteractiveServerRenderMode(prerender: false))

@implements IDisposable

<div class="weather-page">
    <h1 class="page-title">Weather forecast</h1>

    <section class="card card--location">
        <h2>Location</h2>

        <div class="field">
            <label for="country-select">Country</label>
            <select id="country-select" class="input" value="@_selectedCountryId" @onchange="OnCountryChanged">
                <option value="">— select a country —</option>
                @foreach (var country in _countries)
                {
                    <option value="@country.Id">@country.Name</option>
                }
            </select>
            @if (_countriesError is not null)
            {
                <p class="field-hint field-hint--error">@_countriesError</p>
            }
        </div>

        @if (!string.IsNullOrEmpty(_selectedCountryId))
        {
            <div class="field">
                <label for="city-input">Town / city</label>
                <input id="city-input" class="input" type="text" autocomplete="off"
                       placeholder="Type at least @MinQueryLength characters…"
                       value="@_cityQuery" @oninput="OnCityQueryChangedAsync" />

                @if (_isSearching)
                {
                    <p class="field-hint">Searching…</p>
                }
                else if (_searchError is not null)
                {
                    <p class="field-hint field-hint--error">@_searchError</p>
                }
                else if (_noMatches)
                {
                    <p class="field-hint">No towns or cities found.</p>
                }

                @if (_suggestions.Count > 0)
                {
                    <ul class="suggestions">
                        @foreach (var city in _suggestions)
                        {
                            <li>
                                <button type="button" class="suggestion" @onclick="() => SelectCityAsync(city)">
                                    <span class="suggestion-name">@city.Name</span>
                                    <span class="suggestion-detail">@city.FullName</span>
                                </button>
                            </li>
                        }
                    </ul>
                }
            </div>
        }
    </section>

    @if (_isLoading)
    {
        <div class="state state--loading">
            <div class="spinner" aria-hidden="true"></div>
            <p>Loading weather…</p>
        </div>
    }
    else if (_error is not null)
    {
        <div class="state state--error">
            <p>@_error</p>
            <button type="button" class="btn btn--retry" @onclick="LoadAsync">Retry</button>
        </div>
    }
    else if (_weather is not null)
    {
        <section class="card card--current">
            <div class="current-header">
                <div>
                    <h1>@_weather.CurrentWeather.LocationName</h1>
                    <p class="date">@_weather.CurrentWeather.LocalDateTime.ToString("MMM d")</p>
                </div>
                <button type="button" class="btn btn--reload" @onclick="LoadAsync" aria-label="Reload weather" title="Reload weather">↻</button>
            </div>

            <div class="current-main">
                <img src="@_weather.CurrentWeather.ConditionIconUrl" alt="@_weather.CurrentWeather.ConditionText" class="condition-icon" />
                <span class="temperature">@FormatTemp(_weather.CurrentWeather.Temperature)</span>
            </div>

            <dl class="current-details">
                <div class="detail">
                    <dt>Feels</dt>
                    <dd>@FormatTemp(_weather.CurrentWeather.FeelsLike)</dd>
                </div>
                <div class="detail">
                    <dt>Humidity</dt>
                    <dd>@_weather.CurrentWeather.HumidityPercent%</dd>
                </div>
                <div class="detail">
                    <dt>Wind</dt>
                    <dd>@_weather.CurrentWeather.WindKph.ToString("0") km/h</dd>
                </div>
            </dl>
        </section>

        <section class="card card--hourly">
            <h2>Hourly</h2>
            <div class="hourly-scroll">
                @if (TodayHours.Any())
                {
                    <div class="hourly-group">
                        <p class="hourly-group-label">Today</p>
                        <div class="hourly-group-items">
                            @foreach (var hour in TodayHours)
                            {
                                <div class="hour-chip">
                                    <span class="hour-label">@hour.Time.ToString("HH")</span>
                                    <img src="@hour.ConditionIconUrl" alt="" class="hour-icon" />
                                    <span class="hour-temp">@FormatTemp(hour.Temperature)</span>
                                </div>
                            }
                        </div>
                    </div>
                }

                @if (TodayHours.Any() && TomorrowHours.Any())
                {
                    <div class="hourly-separator"></div>
                }

                @if (TomorrowHours.Any())
                {
                    <div class="hourly-group">
                        <p class="hourly-group-label">Tomorrow</p>
                        <div class="hourly-group-items">
                            @foreach (var hour in TomorrowHours)
                            {
                                <div class="hour-chip">
                                    <span class="hour-label">@hour.Time.ToString("HH")</span>
                                    <img src="@hour.ConditionIconUrl" alt="" class="hour-icon" />
                                    <span class="hour-temp">@FormatTemp(hour.Temperature)</span>
                                </div>
                            }
                        </div>
                    </div>
                }
            </div>
        </section>

        <section class="card card--three-day">
            <h2>3-Day Forecast</h2>
            <div class="three-day-list">
                @foreach (var day in _weather.Forecast.ThreeDay)
                {
                    <div class="three-day-row">
                        <span class="day-label">@day.Label</span>
                        <span class="day-min">@FormatTemp(day.MinTemp)</span>
                        <span class="day-max">@FormatTemp(day.MaxTemp)</span>
                    </div>
                }
            </div>
        </section>
    }
</div>

@code {
    private const int MinQueryLength = 4;

    private static readonly TimeSpan SearchDelay = TimeSpan.FromMilliseconds(500);

    private IReadOnlyCollection<CountryDto> _countries = [];
    private IReadOnlyCollection<CityDto> _suggestions = [];
    private string? _countriesError;

    private string _selectedCountryId = string.Empty;
    private string _cityQuery = string.Empty;
    private CityDto? _selectedCity;
    private bool _isSearching;
    private bool _noMatches;
    private string? _searchError;

    private WeatherDto? _weather;
    private bool _isLoading;
    private string? _error;

    private readonly CancellationTokenSource _lifetimeCts = new();

    private CancellationTokenSource? _weatherCts;
    private CancellationTokenSource? _searchCts;

    private IEnumerable<HourlyForecastDto> TodayHours =>
        _weather?.Forecast.Today?.Hours ?? [];

    private IEnumerable<HourlyForecastDto> TomorrowHours =>
        _weather?.Forecast.Tomorrow?.Hours ?? [];

    protected override async Task OnInitializedAsync()
    {
        try
        {
            var result = await Sender.Send(new GetCountriesQuery(), _lifetimeCts.Token);

            _countries = result.IsSuccess ? result.Value ?? [] : [];
            _countriesError = result.IsSuccess ? null : result.Error;
        }
        catch (OperationCanceledException)
        {
            // The user navigated away while the country list was loading.
        }
    }

    private void OnCountryChanged(ChangeEventArgs args)
    {
        _selectedCountryId = args.Value?.ToString() ?? string.Empty;

        CancelSearch();
        CancelWeather();

        _cityQuery = string.Empty;
        _suggestions = [];
        _selectedCity = null;
        _isSearching = false;
        _noMatches = false;
        _searchError = null;
        _weather = null;
        _error = null;
        _isLoading = false;
    }

    private async Task OnCityQueryChangedAsync(ChangeEventArgs args)
    {
        _cityQuery = args.Value?.ToString() ?? string.Empty;
        _suggestions = [];
        _isSearching = false;
        _noMatches = false;
        _searchError = null;

        CancelSearch();

        var searchTerm = _cityQuery.Trim();

        if (searchTerm.Length < MinQueryLength)
        {
            return;
        }

        _searchCts = new CancellationTokenSource();
        var cancellationToken = _searchCts.Token;

        try
        {
            // Debounce: only the keystroke the user pauses after reaches the geo API.
            await Task.Delay(SearchDelay, cancellationToken);

            _isSearching = true;
            StateHasChanged();

            var result = await Sender.Send(new SearchCitiesQuery(_selectedCountryId, searchTerm), cancellationToken);

            if (cancellationToken.IsCancellationRequested)
            {
                return;
            }

            _suggestions = result.IsSuccess ? result.Value ?? [] : [];
            _searchError = result.IsSuccess ? null : result.Error;
            _noMatches = result.IsSuccess && _suggestions.Count == 0;
        }
        catch (OperationCanceledException)
        {
            return;
        }
        finally
        {
            if (!cancellationToken.IsCancellationRequested)
            {
                _isSearching = false;
                StateHasChanged();
            }
        }
    }

    private async Task SelectCityAsync(CityDto city)
    {
        CancelSearch();

        _selectedCity = city;
        _cityQuery = city.Name;
        _suggestions = [];
        _isSearching = false;
        _noMatches = false;
        _searchError = null;

        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        if (_selectedCity is null)
        {
            return;
        }

        CancelWeather();

        _weatherCts = new CancellationTokenSource();
        var cancellationToken = _weatherCts.Token;

        _isLoading = true;
        _error = null;
        StateHasChanged();

        try
        {
            var query = new GetWeatherQuery(_selectedCity.Latitude, _selectedCity.Longitude);
            var result = await Sender.Send(query, cancellationToken);

            if (cancellationToken.IsCancellationRequested)
            {
                return;
            }

            _weather = result.IsSuccess ? result.Value : _weather;
            _error = result.IsSuccess ? null : result.Error;
        }
        catch (OperationCanceledException)
        {
            return;
        }
        finally
        {
            if (!cancellationToken.IsCancellationRequested)
            {
                _isLoading = false;
                StateHasChanged();
            }
        }
    }

    private void CancelSearch()
    {
        _searchCts?.Cancel();
        _searchCts?.Dispose();
        _searchCts = null;
    }

    private void CancelWeather()
    {
        _weatherCts?.Cancel();
        _weatherCts?.Dispose();
        _weatherCts = null;
    }

    private static string FormatTemp(double celsius) => $"{celsius:0}°";

    public void Dispose()
    {
        _lifetimeCts.Cancel();
        _lifetimeCts.Dispose();

        CancelSearch();
        CancelWeather();
    }
}
